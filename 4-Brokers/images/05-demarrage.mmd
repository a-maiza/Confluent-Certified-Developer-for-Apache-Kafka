flowchart LR
    subgraph FRAME [" "]
        direction LR
        subgraph WAY1 ["📦 Voie 1 : Tarball"]
            direction TB
            T1["⬇️ Télécharger<br/>tarball Kafka"] --> T2["📂 Décompresser"]
            T2 --> T3["▶️ Script de démarrage"]
            T3 --> T4["☕ Process JVM<br/>= 1 broker"]
        end

        subgraph WAY2 ["🐳 Voie 2 : Docker Compose"]
